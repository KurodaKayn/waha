PORT=3001
WAHA_URL=http://waha:3000
WAHA_API_KEY=replace-with-your-waha-api-key
WAHA_SESSION=default
# A stable account/server identity, shared by replicas of the same account.
# Use different IDs for unrelated WAHA servers that both use session 'default'.
WAHA_ACCOUNT_ID=my-whatsapp-account
LLM_BASE_URL=https://llm.sufy.com
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=deepseek-v4-pro
WEBHOOK_SECRET=replace-with-a-random-webhook-secret
SYSTEM_PROMPT=You are a helpful WhatsApp assistant. Reply in the same language as the user. Be concise and accurate.
REDIS_URL=redis://redis:6379
HISTORY_MAX_MESSAGES=10
HISTORY_TTL_SECONDS=2592000
EVENT_TTL_SECONDS=604800

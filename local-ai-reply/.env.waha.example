WAHA_API_KEY=replace-with-the-same-key-as-in-dotenv
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=replace-with-a-dashboard-password
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=replace-with-a-swagger-password
WAHA_DASHBOARD_ENABLED=True
WHATSAPP_SWAGGER_ENABLED=True
WHATSAPP_DEFAULT_ENGINE=GOWS
WAHA_GOWS_QR_AUTO_RESTART=true
WAHA_BASE_URL=http://your-server-ip:3000
WHATSAPP_API_HOSTNAME=0.0.0.0
WHATSAPP_API_PORT=3000
WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_FOLDER=/app/.media
WAHA_LOG_FORMAT=JSON
WAHA_PRINT_QR=False
WHATSAPP_HOOK_URL=http://ai:3001/webhook/waha
WHATSAPP_HOOK_EVENTS=message
WHATSAPP_HOOK_HMAC_KEY=replace-with-the-same-webhook-secret-as-in-dotenv
